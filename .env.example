# ============================================================
# Last Bench — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ----- DATABASE (Supabase Postgres — free tier) --------------
# Project: the-last-bench (ap-southeast-1) — already provisioned.
# Get the real password: https://supabase.com/dashboard/project/tocxdyqlrvzthpexnmxe/settings/database
# Use the "Transaction pooler" connection string (port 6543) for serverless-friendly pooling.
# Format: postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres.tocxdyqlrvzthpexnmxe:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ----- AUTH -------------------------------------------------
# Generate a random secret: openssl rand -base64 32
JWT_SECRET=your-random-secret-here

# ----- MANUS PLATFORM (provided by Manus) ------------------
OAUTH_SERVER_URL=https://oauth.manus.space
VITE_APP_ID=your-app-id
OWNER_OPEN_ID=your-owner-open-id

# ----- AI / LLM (provided by Manus or use your own) --------
BUILT_IN_FORGE_API_URL=https://api.anthropic.com
BUILT_IN_FORGE_API_KEY=sk-ant-...

# ============================================================
# CLIENT-SIDE (baked into web build at build time)
# Set these in Vercel environment variables
# ============================================================

# Backend URL (set to your Render.com URL after deploying backend)
EXPO_PUBLIC_API_BASE_URL=https://last-bench-api.onrender.com

# Manus OAuth (same values as server-side above)
EXPO_PUBLIC_OAUTH_PORTAL_URL=https://manus.space
EXPO_PUBLIC_OAUTH_SERVER_URL=https://oauth.manus.space
EXPO_PUBLIC_APP_ID=your-app-id
EXPO_PUBLIC_OWNER_OPEN_ID=your-owner-open-id
EXPO_PUBLIC_OWNER_NAME=Last Bench
