# Last Bench environment template
#
# Never commit real credentials. Server values belong in Render. Public Expo
# values belong in Netlify because they are baked into the browser bundle by
# `pnpm build:web:production`.

# ---------------------------------------------------------------------------
# Render API (server-side)
# ---------------------------------------------------------------------------

NODE_ENV=production

# Render assigns PORT automatically. Use 3000 only for local development.
PORT=3000

# Supabase Postgres transaction-pooler URL (TLS required).
DATABASE_URL=postgres://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-random-secret

# Manus OAuth server configuration.
OAUTH_SERVER_URL=https://oauth.manus.space
VITE_APP_ID=replace-with-manus-app-id
OWNER_OPEN_ID=replace-with-owner-open-id

# Canonical browser origin. The OAuth callback appends /app.
FRONTEND_URL=https://www.lastbenchbd.com

# Comma-separated additional browser origins. Keep this narrow. Include the
# canonical domain and the active Netlify fallback/preview origin only.
CORS_ALLOWED_ORIGINS=https://www.lastbenchbd.com,https://exitbd.netlify.app

# Render normally forwards through one trusted proxy hop.
TRUST_PROXY_HOPS=1

# Forge-compatible gateway used by chat, model discovery, storage presigning,
# notifications, image generation, transcription, and related platform calls.
# Do not point this at api.anthropic.com: this code expects Forge-specific
# endpoints in addition to OpenAI-compatible /v1 endpoints.
BUILT_IN_FORGE_API_URL=https://replace-with-forge-gateway.example.com
BUILT_IN_FORGE_API_KEY=replace-with-forge-key

# Must be a model ID supported by BUILT_IN_FORGE_API_URL.
AI_GUIDANCE_MODEL=replace-with-supported-model-id

# Optional. Off by default. When enabled, only redacted error summaries are
# sent for diagnosis and every generated fix remains advisory until approved.
AUTO_DIAGNOSE_ERRORS=false

# ---------------------------------------------------------------------------
# Netlify web build (public values baked into dist/app)
# ---------------------------------------------------------------------------

# The Render service must be attached to this same-site custom domain before
# production auth is released. There is no production static-site fallback.
EXPO_PUBLIC_API_BASE_URL=https://api.lastbenchbd.com

EXPO_PUBLIC_OAUTH_PORTAL_URL=https://manus.space
EXPO_PUBLIC_OAUTH_SERVER_URL=https://oauth.manus.space
EXPO_PUBLIC_APP_ID=replace-with-manus-app-id
EXPO_PUBLIC_OWNER_OPEN_ID=replace-with-owner-open-id
EXPO_PUBLIC_OWNER_NAME=Last Bench
